# ============================================================
# jelly_code 生产环境配置示例 (v1.3.1)
# ============================================================
#
# 【使用方式】
#   1. 复制此文件:  cp config/env/production.env.example .env
#   2. 修改以下标记为 🔴 的字段（必填）
#   3. 启动服务:    npm start
#
# 【快速验证】
#   最小可行配置只需改 3 项: NEO4J_PASSWORD + TYPESENSE_API_KEY + LLM_ENDPOINTS_JSON 中的 apiKey
#   其他都有安全默认值，可保持不动
#
# ============================================================

# ===== 服务端口 =====
PORT=8095

# ===== Neo4j 图谱存储（必填 🔴）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here     # 🔴 改为真实密码

# ===== Typesense 全文搜索（必填 🔴）=====
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=your-api-key-here   # 🔴 改为真实 API Key

# ===== Qdrant 向量搜索（可选）=====
# 如果不启用向量搜索，保持为空即可。系统会自动降级到全文搜索。
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ====================================================================
# v1.3.1 新增: LLM 弹性池
# ====================================================================
# 【概念】v1.3.1 将 LLM 调用从"单点直连"升级为"多端点池"模式:
#   - 支持 primary + fallback 多端点，一个挂自动切到下一个
#   - 每个端点独立熔断器: 连续失败 5 次 → 熔断 30 秒 → 半开探测
#   - 端点间用 priority 策略: 先试 primary，失败后试 fallback
#
# 【场景示例】
#   场景 A: 只用远程 API（简单）
#     LLM_ENDPOINTS_JSON='[{"url":"https://api.xxx.com/v1","model":"gpt-4","apiKey":"sk-xxx"}]'
#
#   场景 B: 远程 API + 本地 ollama 兜底（推荐）
#     LLM_ENDPOINTS_JSON='[{"url":"https://api.xxx.com/v1","model":"gpt-4","apiKey":"sk-xxx","role":"primary"},{"url":"http://localhost:11434","model":"qwen3:14b","role":"fallback"}]'
#
#   场景 C: 纯本地（无网络依赖）
#     LLM_ENDPOINTS_JSON='[{"url":"http://localhost:11434","model":"qwen3:14b","role":"primary"}]'

# 🔴 必填: LLM 端点池（JSON 数组）
# 每个元素字段:
#   - url:     端点地址（必填）
#   - model:   模型名（必填）
#   - role:    "primary" | "fallback"（选填，默认 primary）
#   - apiKey:  API Key（选填，可改用 apiKeyEnv/apiKeyFile）
#   - weight:  weighted 策略时用的权重（选填，默认 1）
LLM_ENDPOINTS_JSON='[
  {"url":"https://api.scnet.cn/api/llm/v1","model":"MiniMax-M2.5","role":"primary","apiKey":"sk-your-primary-key"},
  {"url":"http://172.80.1.203:11434","model":"qwen3:14b","role":"fallback"},
  {"url":"http://172.80.1.204:11434","model":"qwen3:14b","role":"fallback"}
]'

# 负载均衡策略
#   priority          = 按 role 顺序，primary 优先（推荐）
#   round-robin       = 轮流分发
#   weighted          = 按 weight 比例分发（需端点设 weight 字段）
#   least-connections = 分发到当前并发最少的端点
LLM_POOL_STRATEGY=priority

# 以下参数都有安全默认值，可按需调整
LLM_MAX_CONCURRENCY=8                # Pool 级最大并发数（默认: CPU×2）
LLM_RATE_LIMIT_PER_MIN=240           # 每分钟速率限制（0 = 不限）
LLM_TIMEOUT_MS=60000                 # 单次调用超时（毫秒）
LLM_RETRY_ATTEMPTS=2                 # 失败后重试次数
LLM_RETRY_BACKOFF_MS=1000            # 重试间隔（毫秒，指数退避）
LLM_CIRCUIT_FAILURE_THRESHOLD=5      # 熔断阈值: 连续失败 N 次后熔断
LLM_CIRCUIT_RESET_MS=30000           # 熔断持续时间（毫秒），到期后半开探测
LLM_WORKER_CONCURRENCY=2             # LLM worker 并发数
LLM_QUEUE_BATCH_SIZE=10              # 每批取多少个 job

# ====================================================================
# v1.3.1 新增: Embedding 弹性池
# ====================================================================
# 【概念】多台 ollama 组成 embedding 节点池，least-connections 策略分发:
#   - 单节点挂不影响其他节点（熔断隔离）
#   - 单节点退化正常（不因"策略与节点数不匹配"报错）
#
# 【前提】各节点都已部署 ollama 并 pull 了 bge-m3 模型:
#   curl http://172.80.1.203:11434/api/tags   # 确认 ollama 运行中
#   ollama pull bge-m3                         # 若未拉取

# 多节点 URL 列表（逗号分隔）
CODE_EMBEDDING_URLS=http://172.80.1.203:11434,http://172.80.1.204:11434,http://172.80.1.205:11434,http://172.80.1.206:11434

# 🔴 单节点场景（只用 1 台 ollama）:
# CODE_EMBEDDING_URLS=http://172.80.1.203:11434

CODE_EMBEDDING_LOAD_BALANCE=least-connections   # 分发策略（固定为 least-connections）
CODE_EMBEDDING_MODEL=bge-m3                      # 模型名（各节点需一致）
CODE_EMBEDDING_DIMS=1024                         # 向量维度（需与模型匹配）

# 以下参数都有安全默认值
CODE_EMBEDDING_MAX_CONCURRENCY=16        # Pool 级最大并发
CODE_EMBEDDING_PER_NODE_CONCURRENCY=4    # 每节点最大并发
CODE_EMBEDDING_TIMEOUT_MS=30000          # 单次调用超时
CODE_EMBEDDING_RETRY_ATTEMPTS=2          # 失败重试次数
CODE_EMBEDDING_RETRY_BACKOFF_MS=1000     # 重试间隔
CODE_EMBEDDING_CIRCUIT_FAILURE_THRESHOLD=5   # 熔断阈值
CODE_EMBEDDING_CIRCUIT_RESET_MS=30000        # 熔断持续时间
EMBEDDING_WORKER_CONCURRENCY=2           # Embedding worker 并发数
EMBEDDING_QUEUE_BATCH_SIZE=16            # 每批取多少个 embedding job

# ====================================================================
# 向后兼容: 旧配置（自动忽略）
# ====================================================================
# 以下配置在 v1.3.1 中已被 LLM_ENDPOINTS_JSON 和 CODE_EMBEDDING_URLS 替代。
# 如果 .env 中还保留着它们，系统会自动忽略并优先使用新配置。
# 保留在这里供迁移参考，可以安全删除:
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3:14b
# CODE_EMBEDDING_URL=http://localhost:11434

# ===== Git Clone 缓存（选填）=====
# 代码分析时 clone 仓库的缓存目录
REPO_CACHE_DIR=/data/code_strone
REPO_FULL_CLONE=true                  # true = git clone --depth=0, false = shallow clone
REPO_CLONE_TIMEOUT=600000             # clone 超时（毫秒，默认 10 分钟）
REPO_FETCH_TIMEOUT=300000             # fetch 超时（毫秒，默认 5 分钟）
