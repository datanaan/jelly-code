{
  "name": "jelly-code",
  "version": "1.3.1",
  "description": "MCP-native, multi-language code knowledge graph service — analyze repos, map APIs, trace evolution",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "jelly-code": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "tsx src/cli/index.ts analyze",
    "mcp": "tsx src/cli/index.ts mcp",
    "lint": "tsc --noEmit",
    "postbuild": "python3 scripts/fix-shared-paths.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "bullmq": "^5.80.9",
    "cockatiel": "^4.0.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "glob": "^13.0.6",
    "graphology": "^0.25.4",
    "graphology-indices": "^0.17.0",
    "graphology-utils": "^2.3.0",
    "ioredis": "^5.11.1",
    "lru-cache": "^11.3.6",
    "neo4j-driver": "^5.27.0",
    "onnxruntime-node": "^1.24.0",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "tree-sitter": "0.21.1",
    "tree-sitter-c": "0.21.4",
    "tree-sitter-c-sharp": "0.21.3",
    "tree-sitter-cpp": "0.22.3",
    "tree-sitter-go": "0.21.2",
    "tree-sitter-java": "0.21.0",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-php": "0.22.8",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-ruby": "0.21.0",
    "tree-sitter-rust": "0.21.0",
    "tree-sitter-typescript": "0.21.2",
    "typesense": "^1.8.2",
    "undici": "^8.8.0",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
