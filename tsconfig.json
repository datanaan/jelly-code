{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared": ["./src/shared/index.ts"]
    }
  },
  "include": [
    "src/store/**/*.ts",
    "src/auth/**/*.ts",
    "src/config/**/*.ts",
    "src/server/**/*.ts",
    "src/cli/**/*.ts",
    "src/core/run-analyze.ts",
    "src/core/search/**/*.ts",
    "src/core/graph/**/*.ts",
    "src/core/tree-sitter/**/*.ts",
    "src/core/ingestion/index.d.ts",
    "src/core/ingestion/pipeline-core.ts",
    "src/core/ingestion/pipeline-stages.ts",
    "src/types/**/*.ts",
    "src/lib/**/*.ts",
    "src/shared/**/*.ts",
    "src/mcp/**/*.ts",
    "src/llm/**/*.ts",
    "src/wiki/**/*.ts",
    "src/temporal/**/*.ts",
    "src/coupling/**/*.ts",
    "src/prediction/**/*.ts",
    "src/lineage/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}
