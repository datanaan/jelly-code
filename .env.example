# 部署模式: jelly | standalone
DEPLOY_MODE=standalone

# 服务端口
PORT=8095

# Neo4j (图谱存储)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# Typesense (全文搜索)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=your-api-key-here

# Qdrant (向量搜索 - 可选)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 嵌入配置
# EMBEDDING_PROVIDER=local  # "local" (preferred) or "http"
# 使用 HTTP 嵌入模式时:
# CODE_EMBEDDING_URL=http://localhost:11434/v1
# CODE_EMBEDDING_MODEL=nomic-embed-text
# CODE_EMBEDDING_DIMS=768
# CODE_EMBEDDING_API_KEY=

# Jelly 模式专用
JELLY_API_URL=http://localhost:8000
JELLY_SHARED_SECRET=

# 独立模式专用
STANDALONE_API_KEYS=dev_key_1,dev_key_2

# ===== Git Clone 缓存 =====
REPO_CACHE_DIR=/data/code_strone
REPO_FULL_CLONE=true
REPO_CLONE_TIMEOUT=600000
REPO_FETCH_TIMEOUT=300000

# ===== v1.4.0 Resilience Layer — LLM 配置 =====
# 多端点池 (JSON 格式，含凭证/权重)
# LLM_ENDPOINTS_JSON='[{"url":"http://ollama1:11434","model":"qwen3:14b","role":"peer"},{"url":"http://ollama2:11434","model":"qwen3:14b","role":"peer"}]'
# 简写 (逗号分隔 URL，无凭证场景)
# LLM_ENDPOINTS=http://ollama1:11434,http://ollama2:11434
# 负载均衡策略: priority | round-robin | weighted | least-connections (默认: priority)
# LLM_POOL_STRATEGY=priority
# Pool 级最大并发 (默认: CPU×2)
# LLM_MAX_CONCURRENCY=8
# 每分钟速率限制 (默认: 0 = 不限)
# LLM_RATE_LIMIT_PER_MIN=240
# cockatiel 超时/重试/熔断参数
# LLM_TIMEOUT_MS=60000
# LLM_RETRY_ATTEMPTS=2
# LLM_RETRY_BACKOFF_MS=1000
# LLM_CIRCUIT_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_RESET_MS=30000
# 队列级配置
# LLM_WORKER_CONCURRENCY=2
# LLM_QUEUE_BATCH_SIZE=10

# ===== v1.4.0 Resilience Layer — Embedding 配置 =====
# 多端点池 (逗号分隔 URL)
# CODE_EMBEDDING_URLS=http://172.80.1.203:11434,http://172.80.1.204:11434,http://172.80.1.205:11434,http://172.80.1.206:11434
# 负载均衡策略 (默认: least-connections)
# CODE_EMBEDDING_LOAD_BALANCE=least-connections
# Pool 级最大并发
# CODE_EMBEDDING_MAX_CONCURRENCY=16
# 每节点最大并发
# CODE_EMBEDDING_PER_NODE_CONCURRENCY=4
# cockatiel 超时/重试/熔断参数
# CODE_EMBEDDING_TIMEOUT_MS=30000
# CODE_EMBEDDING_RETRY_ATTEMPTS=2
# CODE_EMBEDDING_RETRY_BACKOFF_MS=1000
# CODE_EMBEDDING_CIRCUIT_FAILURE_THRESHOLD=5
# CODE_EMBEDDING_CIRCUIT_RESET_MS=30000
# 队列级配置
# EMBEDDING_WORKER_CONCURRENCY=2
# EMBEDDING_QUEUE_BATCH_SIZE=16
