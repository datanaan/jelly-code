# 服务端口配置
PORT=8095

# Neo4j (图谱存储)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# Typesense (全文搜索)
TYPESENSE_API_KEY=your-api-key-here
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# Qdrant (向量搜索 - 可选)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# 嵌入配置
# EMBEDDING_PROVIDER=local  # "local" (preferred) or "http"
# 使用 HTTP 嵌入模式时:
# CODE_EMBEDDING_URL=http://localhost:11434/v1
# CODE_EMBEDDING_MODEL=nomic-embed-text
# CODE_EMBEDDING_DIMS=768
# CODE_EMBEDDING_API_KEY=
